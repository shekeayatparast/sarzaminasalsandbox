# ─────────────────────────────────────────────────────────────────────
#  Caddyfile template for سرزمین عسل (3X-UI friendly)
#  Caddy automatically obtains and renews Let's Encrypt SSL certificates.
#
#  The site address placeholder is replaced by setup.sh based on the
#  ports actually free on your server:
#    • example.com          → HTTPS on 443 (needs 80+443 free)
#    • example.com:8443     → HTTPS on an alternate port (when 443 is
#                             owned by 3X-UI / xray; cert via port 80)
#    • http://example.com   → plain HTTP on port 80
#    • :8080                → plain HTTP on a custom port
#  setup.sh detects 3X-UI/x-ui/xray and never binds their ports.
# ─────────────────────────────────────────────────────────────────────

{$SITE_ADDR} {
	# Reverse proxy all traffic to the Next.js site (internal port)
	reverse_proxy localhost:3000

	# Compression
	encode gzip zstd

	# Security headers
	header {
		# X-Frame-Options prevents clickjacking
		X-Frame-Options "SAMEORIGIN"
		# X-Content-Type-Options prevents MIME sniffing
		X-Content-Type-Options "nosniff"
		# Referrer-Policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove Caddy version header for security
		-Server
	}

	# Static asset caching (Next.js assets)
	@static {
		path *.js *.css *.svg *.png *.jpg *.jpeg *.gif *.ico *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Access & error logs
	log {
		output file /var/log/caddy/sarzemine-asal-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format common
	}
}
